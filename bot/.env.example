# Пример конфигурации бота. Скопируйте в .env и заполните значения.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Предустановленные администраторы — телеграм user id через запятую
# (узнать свой id можно у @userinfobot)
ADMIN_USER_IDS=11111111,22222222

# Ссылка на сайт сообщества (пункт меню «Об Эквиум»)
ABOUT_URL=https://equium.ru

# Координатор: телефон отображается в меню; username — для кнопки «Написать сообщение»
COORDINATOR_PHONE=+79001234567
COORDINATOR_USERNAME=coordinator_nick

# Готовая ссылка на Google-форму (пункт меню «Стать участником сообщества»)
JOIN_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSExample/viewform

# Путь к базе SQLite (необязательно, по умолчанию bot/bot.db)
# DB_PATH=/var/lib/equium-bot/bot.db
